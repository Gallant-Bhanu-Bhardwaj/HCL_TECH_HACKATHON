# Ujjwal Rail — environment variables (docs/api-contracts.md §13)
# SHARED-FROZEN: these names are the contract (docs/architecture.md §8).
# Copy to .env and adjust; .env itself is gitignored.

# true => MockClient for intent + composition, keyword-only retrieval (§13)
MOCK_LLM=true

# SQLite file path (ignored by git: *.db)
DB_PATH=ujjwal_rail.db

# Reached from containers via host.docker.internal in Compose (architecture §10)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Canonical time zone for all computations (api-contracts §2)
TZ_NAME=Asia/Kolkata

# Store full rendered prompts on each trace (api-contracts §11). Off by default.
TRACE_STORE_PROMPTS=false

# Optional fixed "now" for demos/tests; unset uses the real clock.
# DEFAULT_AS_OF=2026-12-03T08:15:00+05:30
